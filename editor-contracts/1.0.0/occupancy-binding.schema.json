{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tyr:editor:occupancy-binding:1.0.0",
  "description": "An authored forseti occupancy binding profile (0.1.0): Tyr serializes 'profile' as the data file of an evidence-artifact with id 'occupancy-binding-' + id and media type application/vnd.forseti.occupancy-binding+json. The profile's own fields are checked by scripts/attribution_rule.py at the strictness of Bifrost's reader.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "origin": {
      "enum": [
        "synthetic",
        "field"
      ]
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "product": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        }
      ]
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._/-]*$",
        "maxLength": 256
      },
      "minItems": 1,
      "maxItems": 2048,
      "uniqueItems": true
    },
    "profile": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "version",
    "label",
    "origin",
    "capturedAt",
    "reviewer",
    "product",
    "scope",
    "profile"
  ],
  "additionalProperties": false,
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}
