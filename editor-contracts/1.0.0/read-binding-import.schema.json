{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tyr:editor:read-binding-import:1.0.0",
  "description": "An imported Vor read-binding profile (0.1.0), produced at data-edge commissioning and carried unchanged as an evidence-artifact with id 'read-binding-' + id. Tyr reconciles it and never edits it.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "bytesBase64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 87384,
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "origin": {
      "enum": [
        "synthetic",
        "field"
      ]
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "product": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "id",
    "version",
    "label",
    "bytesBase64",
    "sha256",
    "origin",
    "capturedAt",
    "reviewer",
    "product"
  ],
  "additionalProperties": false,
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}
