{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tyr:editor:2.0.0:common.schema.json",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._/-]*$", "maxLength": 200 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$" },
    "scalar": {
      "description": "Integers only; a decimal is a string, as in Mímir's snapshot contract.",
      "type": ["string", "integer", "boolean", "null"]
    },
    "snapshotRef": {
      "type": "object",
      "properties": {
        "kind": { "const": "interpretation-snapshot" },
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "digest": { "$ref": "#/$defs/sha256" }
      },
      "required": ["kind", "id", "version", "digest"],
      "additionalProperties": false
    },
    "profileRef": {
      "type": "object",
      "properties": {
        "kind": { "const": "interpretation-profile" },
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "digest": { "$ref": "#/$defs/sha256" }
      },
      "required": ["kind", "id", "version", "digest"],
      "additionalProperties": false
    },
    "decisionRef": {
      "type": "object",
      "properties": {
        "kind": { "const": "review-decision" },
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "digest": { "$ref": "#/$defs/sha256" }
      },
      "required": ["kind", "id", "version", "digest"],
      "additionalProperties": false
    },
    "assessmentRef": {
      "type": "object",
      "properties": {
        "kind": { "const": "endpoint-assessment" },
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "digest": { "$ref": "#/$defs/sha256" }
      },
      "required": ["kind", "id", "version", "digest"],
      "additionalProperties": false
    },
    "axis": {
      "type": "object",
      "properties": {
        "basis": { "$ref": "#/$defs/text" },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/text" } }
      },
      "required": ["status", "basis", "blockers"]
    },
    "envelope": {
      "type": "object",
      "properties": {
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "note": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    }
  }
}
