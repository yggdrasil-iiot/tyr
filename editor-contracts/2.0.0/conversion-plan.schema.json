{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tyr:editor:2.0.0:conversion-plan.schema.json",
  "title": "ConversionPlan — native items mapped to existing Týr contract candidates, pinned; applying it is a separate act",
  "type": "object",
  "properties": {
    "kind": { "const": "conversion-plan" },
    "contractVersion": { "const": "2.0.0" },
    "id": { "$ref": "urn:tyr:editor:2.0.0:common.schema.json#/$defs/id" },
    "version": { "$ref": "urn:tyr:editor:2.0.0:common.schema.json#/$defs/version" },
    "body": {
      "type": "object",
      "properties": {
        "assessmentRef": { "$ref": "urn:tyr:editor:2.0.0:common.schema.json#/$defs/assessmentRef" },
        "snapshotRef": { "$ref": "urn:tyr:editor:2.0.0:common.schema.json#/$defs/snapshotRef" },
        "profileRef": { "$ref": "urn:tyr:editor:2.0.0:common.schema.json#/$defs/profileRef" },
        "decisionRefs": { "type": "array", "items": { "$ref": "urn:tyr:editor:2.0.0:common.schema.json#/$defs/decisionRef" } },
        "workspace": {
          "type": "object",
          "properties": {
            "revision": { "type": "integer", "minimum": 0 },
            "sha256": { "$ref": "urn:tyr:editor:2.0.0:common.schema.json#/$defs/sha256" }
          },
          "required": ["revision", "sha256"],
          "additionalProperties": false
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nativeNodeId": { "$ref": "urn:tyr:editor:2.0.0:common.schema.json#/$defs/id" },
              "target": {
                "type": "object",
                "properties": {
                  "kind": { "enum": ["source-definition", "semantic-definition", "mapping-set", "graph", "template", "record-mapping"] },
                  "id": { "$ref": "urn:tyr:editor:2.0.0:common.schema.json#/$defs/id" },
                  "version": { "$ref": "urn:tyr:editor:2.0.0:common.schema.json#/$defs/version" }
                },
                "required": ["kind", "id"],
                "additionalProperties": false
              },
              "basis": { "$ref": "urn:tyr:editor:2.0.0:common.schema.json#/$defs/text" },
              "assumptions": { "type": "array", "items": { "$ref": "urn:tyr:editor:2.0.0:common.schema.json#/$defs/text" } }
            },
            "required": ["nativeNodeId", "target", "basis", "assumptions"],
            "additionalProperties": false
          }
        },
        "losses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "nodeId": { "$ref": "urn:tyr:editor:2.0.0:common.schema.json#/$defs/id" },
              "kind": { "enum": ["unsupported-behavior", "stateful", "precision", "policy-change", "missing-input"] },
              "description": { "$ref": "urn:tyr:editor:2.0.0:common.schema.json#/$defs/text" }
            },
            "required": ["kind", "description"],
            "additionalProperties": false
          }
        },
        "validation": {
          "type": "object",
          "properties": {
            "status": { "enum": ["not-run", "passed", "failed"] },
            "results": { "type": "array", "items": { "$ref": "urn:tyr:editor:2.0.0:common.schema.json#/$defs/text" } }
          },
          "required": ["status", "results"],
          "additionalProperties": false
        },
        "status": {
          "description": "candidate only when the assessment allows it and the snapshot is contract 1.1.0; adopting or submitting stays blocked until P4-F D.",
          "enum": ["draft", "blocked", "candidate"]
        }
      },
      "required": ["assessmentRef", "snapshotRef", "profileRef", "decisionRefs", "workspace", "mappings", "losses", "validation", "status"],
      "additionalProperties": false
    },
    "digest": { "$ref": "urn:tyr:editor:2.0.0:common.schema.json#/$defs/sha256" },
    "envelope": { "$ref": "urn:tyr:editor:2.0.0:common.schema.json#/$defs/envelope" }
  },
  "required": ["kind", "contractVersion", "id", "version", "body", "digest"],
  "additionalProperties": false
}
