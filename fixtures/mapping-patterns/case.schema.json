{
  "type": "object",
  "properties": {
    "fixtureSpecVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "patternId": {
      "type": "string",
      "pattern": "^MP[0-9]{2}$"
    },
    "mode": {
      "enum": [
        "current",
        "gap-probe",
        "planned"
      ]
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object"
    },
    "expect": {
      "type": "object",
      "minProperties": 1
    }
  },
  "required": [
    "fixtureSpecVersion",
    "id",
    "patternId",
    "mode",
    "action",
    "input",
    "expect"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
