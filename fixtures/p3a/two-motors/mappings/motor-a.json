{
  "kind": "mapping-set",
  "schemaVersion": "2.0.0",
  "id": "motor-a-mapping",
  "version": "1.0.0",
  "equipmentInstanceId": "line-a-motor-melsec",
  "targetInstanceRef": {
    "id": "motor-a",
    "version": "1.0.0"
  },
  "mappings": [
    {
      "mappingId": "motor-a-speed-binding",
      "valueRef": {
        "kind": "source",
        "sourceRef": {
          "id": "motor-a-speed",
          "version": "1.0.0"
        }
      },
      "memberPath": [
        {
          "kind": "member",
          "memberId": "actual-speed"
        }
      ],
      "transform": [
        {
          "op": "linear",
          "factor": "0.1",
          "offset": "0"
        },
        {
          "op": "cast",
          "to": "Double",
          "overflow": "error",
          "rounding": "exact"
        }
      ],
      "outputUnit": {
        "status": "known",
        "code": "rpm"
      },
      "invalidValuePolicy": "bad-quality",
      "evidenceRefs": [
        {
          "artifactId": "ev-motor-a-speed",
          "locator": {
            "kind": "text-line",
            "line": 1
          }
        }
      ]
    },
    {
      "mappingId": "motor-a-counter-binding",
      "valueRef": {
        "kind": "graph",
        "graphRef": {
          "id": "motor-a-counter-graph",
          "version": "1.0.0"
        },
        "nodeId": "result"
      },
      "memberPath": [
        {
          "kind": "member",
          "memberId": "cycle-count"
        }
      ],
      "transform": [
        {
          "op": "cast",
          "to": "Int32",
          "overflow": "error",
          "rounding": "exact"
        }
      ],
      "outputUnit": {
        "status": "known",
        "code": "1"
      },
      "invalidValuePolicy": "bad-quality",
      "evidenceRefs": [
        {
          "artifactId": "ev-motor-a-low",
          "locator": {
            "kind": "text-line",
            "line": 1
          }
        },
        {
          "artifactId": "ev-motor-a-high",
          "locator": {
            "kind": "text-line",
            "line": 1
          }
        }
      ]
    }
  ]
}
