{
  "kind": "mapping-set",
  "schemaVersion": "2.3.0",
  "id": "pressure-direct-mapping",
  "version": "1.0.0",
  "equipmentInstanceId": "line-a-motor-melsec",
  "targetInstanceRef": {
    "id": "filter-direct",
    "version": "1.0.0"
  },
  "mappings": [
    {
      "mappingId": "direct-difference",
      "valueRef": {
        "kind": "graph",
        "graphRef": {
          "id": "pressure-direct",
          "version": "1.0.0"
        },
        "nodeId": "difference"
      },
      "memberPath": [
        {
          "kind": "member",
          "memberId": "pressure-difference"
        }
      ],
      "transform": [
        {
          "op": "cast",
          "to": "Double",
          "overflow": "error",
          "rounding": "exact"
        }
      ],
      "outputUnit": {
        "status": "known",
        "code": "kPa"
      },
      "invalidValuePolicy": "bad-quality",
      "evidenceRefs": [
        {
          "artifactId": "manual-pressure-up",
          "locator": {
            "kind": "text-line",
            "line": 1
          }
        },
        {
          "artifactId": "manual-pressure-down",
          "locator": {
            "kind": "text-line",
            "line": 1
          }
        }
      ],
      "temporalPolicy": {
        "timestampBasis": "source",
        "maxAgeMs": 1000,
        "maxSkewMs": 100,
        "uncertainInput": "propagate",
        "missingInput": "reject",
        "badInput": "propagate",
        "assembly": "latest"
      }
    }
  ]
}
