          "id": "array-ab-graph",
          "version": "1.0.0"
        },
        "nodeId": "first"
      },
      "memberPath": [
        {
          "kind": "member",
          "memberId": "actual-pressure"
        }
      ],
      "transform": [
        {
          "op": "cast",
          "to": "Double",
          "overflow": "error",
          "rounding": "exact"
        }
      ],
      "outputUnit": {
        "status": "known",
        "code": "kPa"
      },
      "invalidValuePolicy": "bad-quality",
      "evidenceRefs": [
        {
          "artifactId": "manual-array-pressures-ab",
          "locator": {
            "kind": "text-line",
            "line": 1
          }
        }
      ]
    }
  ]
