{
  "kind": "mapping-set",
  "schemaVersion": "2.4.0",
  "id": "array-ab-first-mapping",
  "version": "1.0.0",
  "equipmentInstanceId": "line-a-motor-ab",
  "targetInstanceRef": {
    "id": "array-ab-first",
    "version": "1.0.0"
  },
  "mappings": [
    {
      "mappingId": "ab-first-pressure",
      "valueRef": {
        "kind": "graph",
